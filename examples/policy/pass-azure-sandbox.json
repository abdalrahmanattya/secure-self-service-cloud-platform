{
  "provider": "azure",
  "mode": "sandbox",
  "environment": "staging",
  "owner": "platform-team",
  "cost_centre": "cc-example",
  "data_classification": "internal",
  "cloud_identifiers_used": false,
  "request": {"provider": "azure"},
  "network": {"kubernetes_api_private": true, "nodes_private": true},
  "encryption": {"at_rest": true, "in_transit": true, "key_rotation": true},
  "logging": {"central": true, "audit": true, "control_plane": true},
  "identity": {
    "least_privilege": true,
    "federation": {
      "issuer": "https://token.actions.githubusercontent.com",
      "audience": "api://AzureADTokenExchange",
      "subject": "repo:example-org/example-platform:environment:platform-apply",
      "lifecycle_roles": {"plan": "plan-identity", "apply": "apply-identity", "destroy": "destroy-identity"}
    }
  },
  "budget": {"monthly_limit": 150, "alerts_enabled": true},
  "resources": {
    "aks": {"private_cluster_enabled": true, "network_plugin": "azure", "workload_identity_enabled": true},
    "key_vault": {"purge_protection": true, "public_network_access": false},
    "activity_log": {"enabled": true},
    "state_storage": {"https_only": true, "public_network_access": false}
  }
}
