{
  "components": {
    "schemas": {
      "CloudProvider": {
        "enum": [
          "aws",
          "azure"
        ],
        "title": "CloudProvider",
        "type": "string"
      },
      "ClusterSize": {
        "enum": [
          "small",
          "medium",
          "large"
        ],
        "title": "ClusterSize",
        "type": "string"
      },
      "DataClassification": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ],
        "title": "DataClassification",
        "type": "string"
      },
      "DeploymentProposal": {
        "additionalProperties": false,
        "description": "Immutable proposal metadata and its complete textual artifact bundle.",
        "properties": {
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ProposalArtifact"
            },
            "minItems": 5,
            "title": "Artifacts",
            "type": "array"
          },
          "content_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Hash",
            "type": "string"
          },
          "installation_id": {
            "minLength": 1,
            "title": "Installation Id",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/InstallationMode"
          },
          "proposal_id": {
            "pattern": "^proposal-[0-9a-f]{16}$",
            "title": "Proposal Id",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/CloudProvider"
          },
          "request_fingerprint": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Request Fingerprint",
            "type": "string"
          },
          "request_id": {
            "pattern": "^env-[0-9a-f]{16}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "default": "proposal.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ProposalState",
            "default": "ready_for_review"
          }
        },
        "required": [
          "proposal_id",
          "content_hash",
          "request_id",
          "request_fingerprint",
          "installation_id",
          "provider",
          "mode",
          "artifacts"
        ],
        "title": "DeploymentProposal",
        "type": "object"
      },
      "EnvironmentRequest": {
        "additionalProperties": false,
        "description": "Raw request submitted by a user; deliberately contains no provider.",
        "properties": {
          "application": {
            "minLength": 1,
            "title": "Application",
            "type": "string"
          },
          "business_justification": {
            "minLength": 1,
            "title": "Business Justification",
            "type": "string"
          },
          "cluster_size": {
            "$ref": "#/components/schemas/ClusterSize"
          },
          "cost_centre": {
            "minLength": 1,
            "title": "Cost Centre",
            "type": "string"
          },
          "data_classification": {
            "$ref": "#/components/schemas/DataClassification"
          },
          "environment": {
            "$ref": "#/components/schemas/EnvironmentType"
          },
          "monthly_budget": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Monthly Budget"
          },
          "network_cidr": {
            "format": "ipvanynetwork",
            "title": "Network Cidr",
            "type": "string"
          },
          "non_production_expiry": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Non Production Expiry"
          },
          "owner": {
            "minLength": 1,
            "title": "Owner",
            "type": "string"
          },
          "region": {
            "minLength": 1,
            "title": "Region",
            "type": "string"
          }
        },
        "required": [
          "application",
          "environment",
          "owner",
          "cost_centre",
          "data_classification",
          "region",
          "network_cidr",
          "cluster_size",
          "monthly_budget",
          "business_justification"
        ],
        "title": "EnvironmentRequest",
        "type": "object"
      },
      "EnvironmentRequestRecord": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/SimulationOutcome"
          },
          "request": {
            "$ref": "#/components/schemas/ResolvedEnvironmentRequest"
          },
          "state": {
            "pattern": "^(accepted|denied)$",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "request",
          "outcome",
          "state",
          "idempotency_key"
        ],
        "title": "EnvironmentRequestRecord",
        "type": "object"
      },
      "EnvironmentType": {
        "enum": [
          "development",
          "test",
          "production"
        ],
        "title": "EnvironmentType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InstallationCreateBody": {
        "additionalProperties": false,
        "properties": {
          "guardrails": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InstallationGuardrails-Input"
              },
              {
                "type": "null"
              }
            ]
          },
          "installation_id": {
            "default": "default",
            "minLength": 1,
            "title": "Installation Id",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/InstallationMode",
            "default": "simulation"
          },
          "provider": {
            "$ref": "#/components/schemas/CloudProvider"
          }
        },
        "required": [
          "provider"
        ],
        "title": "InstallationCreateBody",
        "type": "object"
      },
      "InstallationGuardrails-Input": {
        "additionalProperties": false,
        "description": "Common limits applied before a provider adapter is consulted.",
        "properties": {
          "allowed_cluster_sizes": {
            "default": [
              "small",
              "medium",
              "large"
            ],
            "items": {
              "$ref": "#/components/schemas/ClusterSize"
            },
            "title": "Allowed Cluster Sizes",
            "type": "array"
          },
          "allowed_regions": {
            "default": [
              "example-region"
            ],
            "items": {
              "type": "string"
            },
            "title": "Allowed Regions",
            "type": "array"
          },
          "budget_maximum": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "1000.00",
            "title": "Budget Maximum"
          },
          "max_nonproduction_lifetime_days": {
            "default": 30,
            "maximum": 3650.0,
            "minimum": 1.0,
            "title": "Max Nonproduction Lifetime Days",
            "type": "integer"
          }
        },
        "title": "InstallationGuardrails",
        "type": "object"
      },
      "InstallationGuardrails-Output": {
        "additionalProperties": false,
        "description": "Common limits applied before a provider adapter is consulted.",
        "properties": {
          "allowed_cluster_sizes": {
            "default": [
              "small",
              "medium",
              "large"
            ],
            "items": {
              "$ref": "#/components/schemas/ClusterSize"
            },
            "title": "Allowed Cluster Sizes",
            "type": "array"
          },
          "allowed_regions": {
            "default": [
              "example-region"
            ],
            "items": {
              "type": "string"
            },
            "title": "Allowed Regions",
            "type": "array"
          },
          "budget_maximum": {
            "default": "1000.00",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Budget Maximum",
            "type": "string"
          },
          "max_nonproduction_lifetime_days": {
            "default": 30,
            "maximum": 3650.0,
            "minimum": 1.0,
            "title": "Max Nonproduction Lifetime Days",
            "type": "integer"
          }
        },
        "title": "InstallationGuardrails",
        "type": "object"
      },
      "InstallationMode": {
        "enum": [
          "simulation",
          "sandbox",
          "enterprise"
        ],
        "title": "InstallationMode",
        "type": "string"
      },
      "InstallationProfile": {
        "additionalProperties": false,
        "description": "Provider and lifecycle configuration for one installation.",
        "properties": {
          "guardrails": {
            "$ref": "#/components/schemas/InstallationGuardrails-Output"
          },
          "installation_id": {
            "minLength": 1,
            "title": "Installation Id",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/InstallationMode",
            "default": "simulation"
          },
          "provider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CloudProvider"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/InstallationStatus",
            "default": "draft"
          }
        },
        "required": [
          "installation_id"
        ],
        "title": "InstallationProfile",
        "type": "object"
      },
      "InstallationResponse": {
        "additionalProperties": false,
        "properties": {
          "installation": {
            "$ref": "#/components/schemas/InstallationProfile"
          },
          "validation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InstallationValidation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "installation"
        ],
        "title": "InstallationResponse",
        "type": "object"
      },
      "InstallationStatus": {
        "enum": [
          "draft",
          "active",
          "retired"
        ],
        "title": "InstallationStatus",
        "type": "string"
      },
      "InstallationValidation": {
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "violations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PolicyViolation"
            },
            "title": "Violations",
            "type": "array"
          }
        },
        "required": [
          "allowed"
        ],
        "title": "InstallationValidation",
        "type": "object"
      },
      "ModeDescriptor": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "execution": {
            "title": "Execution",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/InstallationMode"
          }
        },
        "required": [
          "mode",
          "display_name",
          "description",
          "execution"
        ],
        "title": "ModeDescriptor",
        "type": "object"
      },
      "ModeListResponse": {
        "additionalProperties": false,
        "properties": {
          "modes": {
            "items": {
              "$ref": "#/components/schemas/ModeDescriptor"
            },
            "title": "Modes",
            "type": "array"
          }
        },
        "required": [
          "modes"
        ],
        "title": "ModeListResponse",
        "type": "object"
      },
      "PolicyDecision": {
        "additionalProperties": false,
        "description": "Deterministic aggregate policy result.",
        "properties": {
          "allowed": {
            "title": "Allowed",
            "type": "boolean"
          },
          "violations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/PolicyViolation"
            },
            "title": "Violations",
            "type": "array"
          }
        },
        "required": [
          "allowed"
        ],
        "title": "PolicyDecision",
        "type": "object"
      },
      "PolicyViolation": {
        "additionalProperties": false,
        "description": "Stable, user-facing explanation of one failed policy.",
        "properties": {
          "code": {
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "field": {
            "minLength": 1,
            "title": "Field",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "field"
        ],
        "title": "PolicyViolation",
        "type": "object"
      },
      "ProposalArtifact": {
        "additionalProperties": false,
        "description": "One textual file in a proposal bundle.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "relative_path": {
            "minLength": 1,
            "title": "Relative Path",
            "type": "string"
          }
        },
        "required": [
          "relative_path",
          "content"
        ],
        "title": "ProposalArtifact",
        "type": "object"
      },
      "ProposalCreateBody": {
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "ProposalCreateBody",
        "type": "object"
      },
      "ProposalListResponse": {
        "additionalProperties": false,
        "properties": {
          "proposals": {
            "items": {
              "$ref": "#/components/schemas/DeploymentProposal"
            },
            "title": "Proposals",
            "type": "array"
          }
        },
        "required": [
          "proposals"
        ],
        "title": "ProposalListResponse",
        "type": "object"
      },
      "ProposalState": {
        "description": "The only truthful state the local, review-only service can claim.",
        "enum": [
          "ready_for_review"
        ],
        "title": "ProposalState",
        "type": "string"
      },
      "ProviderDescriptor": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "default": true,
            "title": "Available",
            "type": "boolean"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/CloudProvider"
          }
        },
        "required": [
          "provider",
          "display_name",
          "description"
        ],
        "title": "ProviderDescriptor",
        "type": "object"
      },
      "ProviderListResponse": {
        "additionalProperties": false,
        "properties": {
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderDescriptor"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "providers"
        ],
        "title": "ProviderListResponse",
        "type": "object"
      },
      "RequestListResponse": {
        "additionalProperties": false,
        "properties": {
          "requests": {
            "items": {
              "$ref": "#/components/schemas/EnvironmentRequestRecord"
            },
            "title": "Requests",
            "type": "array"
          }
        },
        "required": [
          "requests"
        ],
        "title": "RequestListResponse",
        "type": "object"
      },
      "ResolvedEnvironmentRequest": {
        "additionalProperties": false,
        "description": "Normalized request with the provider resolved from the profile.",
        "properties": {
          "application": {
            "minLength": 1,
            "title": "Application",
            "type": "string"
          },
          "business_justification": {
            "minLength": 1,
            "title": "Business Justification",
            "type": "string"
          },
          "canonical_json": {
            "minLength": 1,
            "title": "Canonical Json",
            "type": "string"
          },
          "cluster_size": {
            "$ref": "#/components/schemas/ClusterSize"
          },
          "cost_centre": {
            "minLength": 1,
            "title": "Cost Centre",
            "type": "string"
          },
          "data_classification": {
            "$ref": "#/components/schemas/DataClassification"
          },
          "environment": {
            "$ref": "#/components/schemas/EnvironmentType"
          },
          "fingerprint": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Fingerprint",
            "type": "string"
          },
          "monthly_budget": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Monthly Budget",
            "type": "string"
          },
          "network_cidr": {
            "format": "ipvanynetwork",
            "title": "Network Cidr",
            "type": "string"
          },
          "non_production_expiry": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Non Production Expiry"
          },
          "owner": {
            "minLength": 1,
            "title": "Owner",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/CloudProvider"
          },
          "region": {
            "minLength": 1,
            "title": "Region",
            "type": "string"
          },
          "request_id": {
            "pattern": "^env-[0-9a-f]{16}$",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "application",
          "environment",
          "owner",
          "cost_centre",
          "data_classification",
          "region",
          "network_cidr",
          "cluster_size",
          "monthly_budget",
          "business_justification",
          "provider",
          "canonical_json",
          "fingerprint",
          "request_id"
        ],
        "title": "ResolvedEnvironmentRequest",
        "type": "object"
      },
      "SimulationOutcome": {
        "additionalProperties": false,
        "description": "Policy decision plus optional deterministic simulation result.",
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/PolicyDecision"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SimulationResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "decision"
        ],
        "title": "SimulationOutcome",
        "type": "object"
      },
      "SimulationResource": {
        "additionalProperties": false,
        "description": "Stable description of a resource that would be proposed.",
        "properties": {
          "attributes": {
            "default": [],
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "title": "Attributes",
            "type": "array"
          },
          "kind": {
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "title": "SimulationResource",
        "type": "object"
      },
      "SimulationResult": {
        "additionalProperties": false,
        "description": "Credential-free simulation output.",
        "properties": {
          "fingerprint": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Fingerprint",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/CloudProvider"
          },
          "request_id": {
            "pattern": "^env-[0-9a-f]{16}$",
            "title": "Request Id",
            "type": "string"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/SimulationResource"
            },
            "title": "Resources",
            "type": "array"
          }
        },
        "required": [
          "provider",
          "request_id",
          "fingerprint",
          "resources"
        ],
        "title": "SimulationResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Credential-free simulation interfaces for a provider-locked self-service cloud platform.",
    "title": "Secure Self-Service Cloud Platform",
    "version": "1.0.0rc1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/v1/deployment-proposals": {
      "get": {
        "operationId": "list_deployment_proposals_v1_deployment_proposals_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProposalListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Deployment Proposals"
      },
      "post": {
        "operationId": "create_deployment_proposal_v1_deployment_proposals_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalCreateBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentProposal"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
